# Markedge — production environment template (Phase 11). Copy to the server's shared .env and fill
# every <placeholder>. Never commit the filled file. Secrets live only on the server / secret manager.

APP_NAME="Markedge Technologies"
APP_ENV=production
APP_KEY=<php artisan key:generate --show>
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://<canonical-host>
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=markedge
DB_USERNAME=markedge_app
DB_PASSWORD=<strong-password>

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=<canonical-host>

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=<redis-password>
REDIS_PORT=6379

FILESYSTEM_DISK=local
MEDIA_DISK=public
IMAGE_DRIVER=imagick

MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@<sender-domain>
MAIL_FROM_NAME="${APP_NAME}"

# Phase 6: only true on the live canonical domain. Staging and previews must stay false.
MARKEDGE_INDEXABLE=true
MARKEDGE_STYLEGUIDE_ENABLED=false
MARKEDGE_ADMIN_EMAIL=<seeded-super-admin-email>
MARKEDGE_ADMIN_PASSWORD=<set-once-then-remove>

# Phase 10 hardening
TRUSTED_PROXIES=*            # or the CDN/load-balancer CIDRs
MARKEDGE_HSTS=true           # only once HTTPS is permanently enforced
MARKEDGE_HSTS_MAX_AGE=31536000
MARKEDGE_CSP=true
MARKEDGE_CSP_REPORT_ONLY=false
MARKEDGE_MEDIA_ORIGINS=      # e.g. https://cdn.<host> when media moves to object storage
MARKEDGE_RATE_SEARCH=30
MARKEDGE_RATE_CTA=60
MARKEDGE_RATE_PREVIEW=60
MARKEDGE_STORE_LEAD_IP=false
MARKEDGE_EVENT_RETENTION_DAYS=400
MARKEDGE_REDIRECT_HOSTS=
