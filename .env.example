APP_NAME="Markedge Technologies"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@markedge.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Initial Super Admin (seeded only when both values are set)
MARKEDGE_ADMIN_NAME="Markedge Admin"
MARKEDGE_ADMIN_EMAIL=
MARKEDGE_ADMIN_PASSWORD=
MARKEDGE_STORE_LEAD_IP=false
MEDIA_DISK=public
# imagick enables AVIF variants (Phase 10); gd keeps WebP only
IMAGE_DRIVER=gd

# Production hardening (Phase 10)
TRUSTED_PROXIES=
MARKEDGE_HSTS=false
MARKEDGE_CSP=true
MARKEDGE_CSP_REPORT_ONLY=false
MARKEDGE_MEDIA_ORIGINS=
MARKEDGE_RATE_SEARCH=30
MARKEDGE_RATE_CTA=60
MARKEDGE_RATE_PREVIEW=60
MARKEDGE_STYLEGUIDE_ENABLED=false
MARKEDGE_INDEXABLE=false
